rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email.lower() == 'rmartinespana@gmail.com';
    }

    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cells/{cellId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date', 'i'])
        && request.resource.data['date'] is string
        && request.resource.data['i'] is int
        && cellId == request.resource.data['date'] + '_' + string(request.resource.data['i']);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /bookings/{id} {
      // La clienta puede leer SU cita si tiene el enlace (el id es largo y aleatorio),
      // pero nadie puede listar todas las citas: eso es solo de la administradora.
      allow get: if true;
      allow list, delete: if isAdmin();

      // La administradora puede cambiar lo que quiera. La clienta solo puede
      // responder a una propuesta: aceptarla o rechazarla (únicamente el campo "status").
      allow update: if isAdmin() || (
        resource.data.get('status', 'confirmed') == 'proposed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data['status'] in ['confirmed', 'declined']
      );

      allow create: if request.resource.data.keys().hasOnly(
          ['name','phone','service','dur','date','start','end','note','cells','created','status'])
        && request.resource.data['status'] == 'pending'
        && request.resource.data['name'] is string
        && request.resource.data['name'].size() > 1
        && request.resource.data['name'].size() <= 80
        && request.resource.data['phone'] is string
        && request.resource.data['phone'].size() >= 9
        && request.resource.data['phone'].size() <= 20
        && request.resource.data['service'] is string
        && request.resource.data['date'] is string
        && request.resource.data['start'] is int
        && request.resource.data['end'] is int
        && request.resource.data['dur'] is int
        && request.resource.data['note'] is string
        && request.resource.data['note'].size() <= 300
        && request.resource.data['cells'] is list
        && request.resource.data['cells'].size() > 0
        && request.resource.data['cells'].size() <= 40;
    }
  }
}
